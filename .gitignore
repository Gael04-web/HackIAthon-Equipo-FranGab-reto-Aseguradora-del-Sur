# Entornos virtuales
venv/
env/
.venv/

# Variables de entorno (¡CRÍTICO NO SUBIR ESTO!)
.env

# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class

# Datos locales generados (excepto el CSV de ejemplo para demo)
data/synthetic/*.csv
!data/synthetic/siniestros.csv

# El dataset Excel no se versiona (es grande y confidencial)
# Colócalo manualmente en data/dataset/ antes de correr load_data.py
data/dataset/*.xlsx

# PDFs del dataset — se suben a Supabase Storage, no al repo
data/docs/*.pdf

# Otros de Sistema / IDE
.DS_Store
.vscode/
.idea/
